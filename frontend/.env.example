# Copie ce fichier en ".env" (déjà dans .gitignore) et remplis les vraies valeurs.

# Adresse du backend FastAPI en local.
VITE_API_BASE_URL=http://localhost:8000

# Même Client ID que GOOGLE_CLIENT_ID côté backend — ce n'est pas un secret
# (contrairement à JWT_SECRET_KEY), il est fait pour être exposé côté navigateur.
VITE_GOOGLE_CLIENT_ID=
