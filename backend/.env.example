# Copie ce fichier en ".env" et remplis les vraies valeurs. Le ".env" ne doit
# JAMAIS être commité (voir .gitignore) — seul ce .env.example l'est.

# --- Base de données (Supabase / PostgreSQL) --------------------------------
# Récupérable dans Supabase > Project Settings > Database > Connection string
# (mode "Session pooler" ou connexion directe, format psycopg3).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# --- Cloudinary (stockage documents/logos) -----------------------------------
# Décision actée dans Wink_context_project.md — pas encore consommées dans le
# code (aucun service d'upload écrit pour l'instant), réservées pour plus tard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Authentification Google --------------------------------------------------
# Utilisée par backend/shared/auth/services/auth_service.py pour vérifier les
# id_token envoyés par le frontend. Vide = connexion Google désactivée (erreur
# claire à l'appel, pas de crash).
GOOGLE_CLIENT_ID=

# --- JWT (auth email + Google) ------------------------------------------------
# Signe les access tokens. Génère une vraie valeur aléatoire pour ton .env local
# (jamais celle-ci) : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-real-random-secret

# Durée de validité de l'access token, en minutes. 1440 = 24h. Non révocable
# une fois émis (JWT stateless) : plus cette valeur est haute, plus un token
# volé reste exploitable longtemps — le refresh token (30 jours, non
# configurable pour l'instant) sert à limiter la durée de vie réelle d'une
# session sans redemander le mot de passe.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SMTP (mot de passe oublié) -----------------------------------------------
# Utilisé par backend/shared/services/email_service.py, consommé par
# backend/shared/auth/services/auth_service.py (forgot-password/reset-password).
# Vide = envoi désactivé (EmailError explicite, pas de crash).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optionnel — si vide, SMTP_USERNAME est réutilisé comme expéditeur.
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# URL du frontend qui affiche le formulaire "nouveau mot de passe" ; le lien
# envoyé par email pointe ici avec ?token=... en query string.
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Durée de validité d'un lien de réinitialisation, en minutes. 60 par défaut —
# volontairement court, contrairement au refresh token.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Groq (extraction de document — agents/shared/document_processing/) ------
# Utilisée par vlm_service.py (vision, transcription du PDF) et llm_service.py
# (extraction structurée). Récupérable sur console.groq.com > API Keys.
# Vide = GroqError explicite à l'appel (voir _get_client dans les deux services).
# Réutilisée également par agents/ingestion/legal_text_structuring_service.py
# (voir section Légifrance/PISTE ci-dessous).
GROQ_API_KEY=

# --- Poppler (extraction de document — requis par pdf2image) -----------------
# Optionnel. Linux/macOS : laisser vide si poppler est installé via le gestionnaire
# de paquets système (déjà dans le PATH). Windows : chemin vers le dossier bin/ de
# poppler (ex: C:\poppler\poppler-25.xx.x\Library\bin) si tu ne veux pas modifier
# le PATH système.
POPPLER_PATH=

# --- Légifrance / PISTE (collecte legal_texts — scrapers/legifrance/) ------
# Créer une application sur https://piste.gouv.fr (API "Légifrance"), récupérer
# client_id/client_secret. Flux OAuth2 client_credentials, scope=openid — voir
# scrapers/legifrance/legifrance_client.py.
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# --- Judilibre, jurisprudence Cour de cassation (service 1.1.13 categorie 3 --
# scrapers/judilibre/judilibre_client.py) ---
# CORRIGE le 22/09/2026 (verifie par appel reel) : Judilibre transite par le
# meme portail PISTE que Legifrance et utilise la MEME auth OAuth2
# client_credentials -- PAS de cle API separee (le header "KeyId" documente
# par judilibre-search echoue en pratique, 400). Reutilise donc directement
# LEGIFRANCE_CLIENT_ID / LEGIFRANCE_CLIENT_SECRET ci-dessus : rien a ajouter
# ici si Legifrance est deja configure. Sur https://piste.gouv.fr, il faut
# quand meme activer "Judilibre" sur l'application Legifrance existante
# (sinon 403, application non abonnee a l'API), mais aucune cle distincte
# n'est generee/utilisee.
# "sandbox" pour tester avant la production -- vide/absent = production
# (comportement par defaut, voir judilibre_client.py).
JUDILIBRE_ENV=

# --- INPI, Base Marques (service 1.1.2 — scrapers/inpi/marques_client.py) ---
# Créer un compte personnel sur https://data.inpi.fr (identifiant/mot de passe,
# pas une simple clé API). Vide = InpiApiError explicite à l'appel (503 côté
# route), pas de crash — voir name_availability_service.py.
INPI_USERNAME=
INPI_PASSWORD=
